@model ProyectoBD.Web.Models.CategoriaViewModel
<div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
<div class="mb-3">
    <label asp-for="NombreCategoria" class="form-label"></label>
    <input asp-for="NombreCategoria" class="form-control" maxlength="45" autocomplete="off" />
    <span asp-validation-for="NombreCategoria" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label"></label>
    <input asp-for="Descripcion" class="form-control" maxlength="60" autocomplete="off" />
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>
