@model IEnumerable<VarianteListadoViewModel>
@{ ViewData["Title"] = "Variantes de producto"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2>Variantes de producto</h2><p class="text-muted mb-0">Presentaciones, colores y precios de venta.</p></div>
    <a asp-action="Crear" asp-route-producto="@ViewBag.Producto" class="btn btn-primary">Nueva variante</a>
</div>
<partial name="_MensajesMantenimiento" />
<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label for="producto" class="form-label">Filtrar por producto</label>
        <select id="producto" name="producto" asp-items="ViewBag.Productos" class="form-select"><option value="">Todos los productos</option></select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Filtrar</button></div>
    <div class="col-auto"><a asp-controller="Productos" asp-action="Index" class="btn btn-outline-secondary">Volver a productos</a></div>
</form>
<div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark"><tr><th>Producto</th><th>Presentación</th><th>Color</th><th class="text-end">Precio de venta</th><th>Acciones</th></tr></thead>
        <tbody>
            @if (!Model.Any()) { <tr><td colspan="5" class="text-muted text-center">No hay variantes para mostrar.</td></tr> }
            @foreach (var variante in Model)
            {
                <tr>
                    <td>@variante.Producto</td><td>@variante.Presentacion</td><td>@variante.Color</td><td class="text-end">@("Q" + variante.PrecioVenta.ToString("N2"))</td>
                    <td class="text-nowrap">
                        <a asp-action="Editar" asp-route-id="@variante.ID_ProductoV" class="btn btn-sm btn-warning">Editar</a>
                        <form asp-action="Eliminar" asp-route-id="@variante.ID_ProductoV" method="post" class="d-inline"
                              onsubmit="return confirm('¿Está seguro de eliminar esta variante?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div></div></div>
