@model CobroViewModel
@{ ViewData["Title"] = "Cobrar factura"; }
<h2 class="mb-4">Cobrar factura N.º @Model.Factura.NumeroFactura</h2>
<partial name="_FacturaDetalle" model="Model.Factura" />
<div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>
@if (Model.Factura.Estado == "Pendiente" && Model.Factura.Saldo > 0)
{
<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Cobrar" asp-route-id="@Model.ID_Factura" method="post" data-cobro>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ID_Factura" />
        <button type="submit" name="accion" value="guardar" class="visually-hidden" tabindex="-1" aria-hidden="true">Guardar</button>
        <div class="d-flex justify-content-between mb-3"><h4>Medios de pago</h4><button name="accion" value="agregar" type="submit" formnovalidate class="btn btn-outline-primary">Agregar pago</button></div>
        <p class="text-muted">Puede registrar un pago parcial o distribuir el saldo entre varios medios. Complete la referencia cuando corresponda al medio utilizado.</p>
        <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Método</th><th>Monto Q</th><th>Referencia</th><th></th></tr></thead><tbody>
        @for (int i = 0; i < Model.Pagos.Count; i++)
        {
            <tr><td><select asp-for="Pagos[i].ID_MetodoP" asp-items="Model.Metodos" class="form-select"><option value="">Seleccione un método</option></select></td>
            <td><input asp-for="Pagos[i].Monto" class="form-control" type="number" min="0.01" max="9999999999.99" step="0.01" data-monto /></td>
            <td><input asp-for="Pagos[i].Referencia" class="form-control" maxlength="100" /></td>
            <td><button name="accion" value="quitar:@i" type="submit" formnovalidate class="btn btn-outline-danger btn-sm">Quitar</button></td></tr>
        }
        </tbody></table></div>
        <p class="text-end fs-5 fw-bold">Total a registrar: <span data-total-pagos>@("Q" + Model.TotalPagos.ToString("N2"))</span></p>
        <button name="accion" value="guardar" type="submit" class="btn btn-success">Registrar pagos</button>
        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </form>
</div></div>
}
else { <p class="alert alert-info">La factura no admite nuevos pagos.</p><a asp-action="Index" class="btn btn-secondary">Volver</a> }
@section Scripts { <script src="~/js/cobros.js" asp-append-version="true"></script> }
