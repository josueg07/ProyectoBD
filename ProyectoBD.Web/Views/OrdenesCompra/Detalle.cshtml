@model OrdenCompraResumenViewModel
@{ ViewData["Title"] = "Orden de compra " + Model.ID_OrdenC; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div><h2>@ViewData["Title"]</h2><p class="text-muted mb-0">@Model.Proveedor · @Model.Fecha.ToString("dd/MM/yyyy")</p></div>
    <span class="badge bg-secondary fs-6">@Model.Estado</span>
</div>
<partial name="_MensajesMantenimiento" />
<div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
<table class="table align-middle"><thead class="table-dark"><tr><th>Producto / presentación / color</th><th>Solicitada</th><th>Recibida</th><th>Pendiente</th></tr></thead>
<tbody>
    @foreach (var linea in Model.Detalle)
    {
        <tr><td>@linea.Producto</td><td>@linea.Solicitada</td><td>@linea.Recibida</td><td class="fw-bold">@linea.Pendiente</td></tr>
    }
</tbody></table>
</div></div></div>
<div class="d-flex flex-wrap gap-2 mt-3">
    @if (Model.Estado == "Pendiente" || Model.Estado == "Parcial")
    {
        <a asp-controller="IngresosBodega" asp-action="Crear" asp-route-orden="@Model.ID_OrdenC" class="btn btn-primary">Registrar ingreso</a>
    }
    <a asp-controller="IngresosBodega" asp-action="Index" asp-route-orden="@Model.ID_OrdenC" class="btn btn-outline-primary">Ver ingresos</a>
    <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
</div>
